{
  "name": "dsh-ticket-context",
  "version": "0.1.0",
  "description": "Ticket scope for dsh-superagent — resolves which Super-agent ticket a Harness Session is acting for (worker-<ticketId> / router) and exposes the per-ticket rule table as a Cordis service, with zero changes to Super-agent.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "superagent",
    "dsh-superagent",
    "governance",
    "ticket",
    "session",
    "multi-agent",
    "orchestration"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run -s build && node --test test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alfred-Lau/dsh-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/Alfred-Lau/dsh-plugins/issues"
  },
  "homepage": "https://github.com/Alfred-Lau/dsh-plugins#readme"
}
